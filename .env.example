# Local development only. `make up` copies this file to .env if .env is missing.
# Never commit .env or real credentials.
POSTGRES_USER=almamater
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=almamater
DB_PORT=5432
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Office 365 app registration in the NaUKMA tenant (ADR-005); the secret goes only into .env
OIDC_CLIENT_ID=e9ab5a16-da5c-4850-9feb-b1924fd5eea4
OIDC_CLIENT_SECRET=
OIDC_AUTHORITY=https://login.microsoftonline.com/b8cbfe43-c90c-4bea-84ae-be5d6d8a5f52/v2.0
# Callback goes through the Vite proxy so the browser stays on one origin
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback

# HMAC key for CSRF tokens and the sign-in transaction cookie; use a long random value
SESSION_SECRET=change-me-local-only
SESSION_MAX_AGE_DAYS=30
SESSION_IDLE_DAYS=7
# Local HTTP only; must be true on HTTPS
COOKIE_SECURE=false
